{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spencerbull/xeneon-edge-agents/schema/portal-v1.schema.json",
  "title": "XENEON EDGE portal protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/snapshotMessage" },
    { "$ref": "#/$defs/actionResultMessage" },
    { "$ref": "#/$defs/noticeMessage" },
    { "$ref": "#/$defs/commandMessage" }
  ],
  "$defs": {
    "agentStatus": {
      "enum": ["blocked", "done", "working", "idle", "unknown"]
    },
    "voiceState": {
      "enum": ["idle", "recording", "processing", "error", "unavailable"]
    },
    "actionKind": {
      "enum": [
        "open",
        "zoom",
        "approve",
        "interrupt",
        "restore_focus",
        "desktop_app",
        "spotify_play_pause",
        "spotify_next",
        "spotify_previous",
        "basecamp_open",
        "slack_open",
        "github_open",
        "game_show",
        "voice_start",
        "voice_stop",
        "voice_cancel",
        "order_grouped",
        "order_priority",
        "backend_herdr",
        "backend_t3code"
      ]
    },
    "agentBackend": {
      "enum": ["herdr", "t3code"]
    },
    "backend": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "$ref": "#/$defs/agentBackend" },
        "switchable": { "type": "boolean" }
      }
    },
    "dashboard": { "enum": ["agents", "spotify", "basecamp", "slack", "github", "game"] },
    "githubId": { "type": "string", "pattern": "^[pn][0-9]{1,20}$" },
    "github": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "organization": { "type": "string", "maxLength": 39 },
        "open_pull_requests": { "type": "integer", "minimum": 0 },
        "pull_requests": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["id", "repo", "number", "title", "author", "draft", "comments", "at"],
            "properties": {
              "id": { "$ref": "#/$defs/githubId" },
              "repo": { "type": "string", "maxLength": 64 },
              "number": { "type": "integer", "minimum": 0 },
              "title": { "type": "string", "maxLength": 160 },
              "author": { "type": "string", "maxLength": 64 },
              "draft": { "type": "boolean" },
              "comments": { "type": "integer", "minimum": 0 },
              "at": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "notifications": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "repo", "reason", "at"],
            "properties": {
              "id": { "$ref": "#/$defs/githubId" },
              "kind": { "enum": ["pr", "issue", "release", "commit", "ci", "discussion", "other"] },
              "title": { "type": "string", "maxLength": 160 },
              "repo": { "type": "string", "maxLength": 128 },
              "reason": { "type": "string", "maxLength": 32 },
              "at": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "slackId": { "type": "string", "pattern": "^[A-Z0-9]{1,24}-[0-9]{1,12}\\.[0-9]{1,8}$" },
    "slack": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "channels": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["name", "available", "unread", "unread_capped", "messages"],
            "properties": {
              "name": { "type": "string", "maxLength": 48 },
              "available": { "type": "boolean" },
              "unread": { "type": "integer", "minimum": 0 },
              "unread_capped": { "type": "boolean" },
              "messages": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["id", "author", "text", "at", "replies", "unread"],
                  "properties": {
                    "id": { "$ref": "#/$defs/slackId" },
                    "author": { "type": "string", "maxLength": 48 },
                    "text": { "type": "string", "maxLength": 500 },
                    "images": {
                      "type": "array",
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "required": ["file", "width", "height"],
                        "properties": {
                          "file": { "type": "string", "pattern": "^F[A-Z0-9]{1,23}\\.(png|jpg|jpeg|gif|webp)$" },
                          "width": { "type": "integer", "minimum": 1 },
                          "height": { "type": "integer", "minimum": 1 }
                        }
                      }
                    },
                    "reactions": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": ["emoji", "count"],
                        "properties": {
                          "emoji": { "type": "string", "minLength": 1, "maxLength": 34 },
                          "count": { "type": "integer", "minimum": 1 }
                        }
                      }
                    },
                    "at": { "type": "integer", "minimum": 0 },
                    "replies": { "type": "integer", "minimum": 0 },
                    "unread": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        "notifications": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["id", "kind", "source", "author", "text", "at", "unread"],
            "properties": {
              "id": { "$ref": "#/$defs/slackId" },
              "kind": { "enum": ["dm", "mention"] },
              "source": { "type": "string", "maxLength": 49 },
              "author": { "type": "string", "maxLength": 48 },
              "text": { "type": "string", "maxLength": 500 },
              "at": { "type": "integer", "minimum": 0 },
              "unread": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "basecampId": { "type": "string", "pattern": "^[nc][0-9]{1,19}$" },
    "basecamp": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "unread_count": { "type": "integer", "minimum": 0 },
        "unreads_capped": { "type": "boolean" },
        "notifications": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "project", "creator", "unread_at"],
            "properties": {
              "id": { "$ref": "#/$defs/basecampId" },
              "kind": { "enum": ["comment", "announcement", "done", "boost", "update"] },
              "title": { "type": "string", "maxLength": 160 },
              "project": { "type": "string", "maxLength": 48 },
              "creator": { "type": "string", "maxLength": 48 },
              "unread_at": { "type": "string", "maxLength": 40 }
            }
          }
        },
        "boards": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "available", "lanes", "not_now", "done"],
            "properties": {
              "label": { "type": "string", "maxLength": 24 },
              "available": { "type": "boolean" },
              "not_now": { "type": "integer", "minimum": 0 },
              "done": { "type": "integer", "minimum": 0 },
              "lanes": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["title", "color", "total", "cards"],
                  "properties": {
                    "title": { "type": "string", "maxLength": 48 },
                    "color": {
                      "enum": ["accent", "red", "orange", "yellow", "green", "blue", "cyan", "magenta"]
                    },
                    "total": { "type": "integer", "minimum": 0 },
                    "cards": {
                      "type": "array",
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "required": ["id", "title", "assignees", "comments"],
                        "properties": {
                          "id": { "$ref": "#/$defs/basecampId" },
                          "title": { "type": "string", "maxLength": 160 },
                          "assignees": {
                            "type": "array",
                            "maxItems": 4,
                            "items": { "type": "string", "maxLength": 48 }
                          },
                          "due_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                          "comments": { "type": "integer", "minimum": 0 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "spotify": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "status": { "enum": ["playing", "paused", "stopped"] },
        "title": { "type": "string", "maxLength": 160 },
        "artist": { "type": "string", "maxLength": 160 },
        "album": { "type": "string", "maxLength": 160 },
        "art_url": { "type": "string", "maxLength": 256, "pattern": "^https://i\\.scdn\\.co/image/" },
        "length_ms": { "type": "integer", "minimum": 0 },
        "position_ms": { "type": "integer", "minimum": 0 },
        "can_control": { "type": "boolean" },
        "can_go_next": { "type": "boolean" },
        "can_go_previous": { "type": "boolean" }
      }
    },
    "lyrics": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["off", "loading", "synced", "plain", "instrumental", "missing", "unavailable"]
        },
        "title": { "type": "string", "maxLength": 160 },
        "artist": { "type": "string", "maxLength": 160 },
        "lines": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "required": ["at_ms", "text"],
            "properties": {
              "at_ms": { "type": "integer", "minimum": 0 },
              "text": { "type": "string", "maxLength": 200 }
            }
          }
        }
      }
    },
    "desktopApp": {
      "type": "object",
      "required": ["id", "label", "accent"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "accent": {
          "enum": [
            "accent",
            "green",
            "blue",
            "cyan",
            "magenta",
            "orange",
            "yellow"
          ]
        }
      }
    },
    "agentOrder": {
      "type": "object",
      "required": ["available", "mode"],
      "properties": {
        "available": { "type": "boolean" },
        "mode": { "enum": ["grouped", "priority"] }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "capability_id",
        "kind",
        "expires_at_ms",
        "expected_revision"
      ],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/actionKind" },
        "expires_at_ms": { "type": "integer", "minimum": 0 },
        "expected_revision": { "type": "integer", "minimum": 0 }
      }
    },
    "metric": {
      "type": "object",
      "required": ["available", "unit"],
      "properties": {
        "available": { "type": "boolean" },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "available": { "const": false } },
            "required": ["available"]
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "health": {
      "type": "object",
      "required": [
        "cpu",
        "cpu_temperature",
        "gpu",
        "gpu_temperature",
        "memory",
        "network_down",
        "network_up",
        "battery"
      ],
      "properties": {
        "cpu": { "$ref": "#/$defs/metric" },
        "cpu_temperature": { "$ref": "#/$defs/metric" },
        "gpu": { "$ref": "#/$defs/metric" },
        "gpu_temperature": { "$ref": "#/$defs/metric" },
        "memory": { "$ref": "#/$defs/metric" },
        "network_down": { "$ref": "#/$defs/metric" },
        "network_up": { "$ref": "#/$defs/metric" },
        "battery": { "$ref": "#/$defs/metric" }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "agent",
        "status",
        "workspace",
        "session",
        "focused",
        "observed_for_seconds",
        "source_order",
        "actions"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string" },
        "agent": { "type": "string" },
        "status": { "$ref": "#/$defs/agentStatus" },
        "review_ready": { "type": "boolean" },
        "launch_pending": { "type": "boolean" },
        "workspace": { "type": "string" },
        "repository": { "type": "string" },
        "worktree": { "type": "string" },
        "branch": { "type": "string", "maxLength": 64 },
        "session": { "type": "string" },
        "focused": { "type": "boolean" },
        "observed_for_seconds": { "type": "integer", "minimum": 0 },
        "source_order": { "type": "integer", "minimum": 0 },
        "actions": {
          "type": "object",
          "required": ["open", "zoom"],
          "properties": {
            "open": { "type": "boolean" },
            "zoom": { "type": "boolean" },
            "approve": { "$ref": "#/$defs/capability" },
            "interrupt": { "$ref": "#/$defs/capability" }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string" },
        "state": {
          "enum": ["connected", "stale", "incompatible", "offline"]
        },
        "version": { "type": "string" },
        "protocol": { "type": "integer", "minimum": 0 },
        "last_sync_ms": { "type": "integer", "minimum": 0 },
        "message": { "type": "string" }
      }
    },
    "voice": {
      "type": "object",
      "required": ["state", "owned"],
      "properties": {
        "state": { "$ref": "#/$defs/voiceState" },
        "owned": { "type": "boolean" }
      }
    },
    "usageWindow": {
      "type": "object",
      "required": ["label", "utilization"],
      "properties": {
        "label": { "type": "string", "maxLength": 24 },
        "utilization": { "type": "number", "minimum": 0, "maximum": 1 },
        "reset_at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "providerUsage": {
      "type": "object",
      "required": [
        "id",
        "label",
        "kind",
        "available",
        "stale",
        "source",
        "status"
      ],
      "properties": {
        "id": { "enum": ["claude", "codex", "opencode"] },
        "label": { "type": "string", "maxLength": 24 },
        "kind": { "enum": ["quota", "local_budget"] },
        "available": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "maxLength": 24 },
        "plan": { "type": "string", "maxLength": 32 },
        "model": { "type": "string", "maxLength": 80 },
        "primary": { "$ref": "#/$defs/usageWindow" },
        "secondary": { "$ref": "#/$defs/usageWindow" },
        "today_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "tokens_per_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "last_updated_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "required": ["providers"],
      "properties": {
        "providers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/providerUsage" }
        }
      }
    },
    "micro": {
      "type": "object",
      "required": ["connected", "charging"],
      "properties": {
        "connected": { "type": "boolean" },
        "firmware": { "type": "string", "maxLength": 32 },
        "battery": { "type": "integer", "minimum": 0, "maximum": 100 },
        "charging": { "type": "boolean" },
        "layer": { "type": "integer", "minimum": 0 },
        "profile": { "type": "integer", "minimum": 0 },
        "last_updated_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "snapshotMessage": {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "sequence",
        "daemon_epoch",
        "generated_at_ms",
        "connection",
        "sessions",
        "agents",
        "health"
      ],
      "properties": {
        "type": { "const": "snapshot" },
        "schema_version": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "daemon_epoch": { "type": "string", "minLength": 1 },
        "generated_at_ms": { "type": "integer", "minimum": 0 },
        "connection": {
          "enum": ["connected", "degraded", "reconnecting", "offline"]
        },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/session" }
        },
        "agents": {
          "type": "array",
          "items": { "$ref": "#/$defs/agent" }
        },
        "agent_order": { "$ref": "#/$defs/agentOrder" },
        "backend": { "$ref": "#/$defs/backend" },
        "dashboards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dashboard" }
        },
        "spotify": { "$ref": "#/$defs/spotify" },
        "lyrics": { "$ref": "#/$defs/lyrics" },
        "basecamp": { "$ref": "#/$defs/basecamp" },
        "slack": { "$ref": "#/$defs/slack" },
        "github": { "$ref": "#/$defs/github" },
        "desktop_apps": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/desktopApp" }
        },
        "voice": { "$ref": "#/$defs/voice" },
        "usage": { "$ref": "#/$defs/usage" },
        "micro": { "$ref": "#/$defs/micro" },
        "health": { "$ref": "#/$defs/health" }
      }
    },
    "actionResultMessage": {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "request_id",
        "ok",
        "code",
        "message"
      ],
      "properties": {
        "type": { "const": "action_result" },
        "schema_version": { "const": 1 },
        "request_id": { "type": "string" },
        "ok": { "type": "boolean" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "noticeMessage": {
      "type": "object",
      "required": ["type", "schema_version", "level", "code", "message"],
      "properties": {
        "type": { "const": "notice" },
        "schema_version": { "const": 1 },
        "level": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "commandMessage": {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "request_id",
        "sequence",
        "action"
      ],
      "properties": {
        "type": { "const": "command" },
        "schema_version": { "const": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "agent_id": { "type": "string", "minLength": 1 },
        "action": { "$ref": "#/$defs/actionKind" },
        "capability_id": { "type": "string", "minLength": 1 },
        "app_id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "item_id": {
          "oneOf": [
            { "$ref": "#/$defs/basecampId" },
            { "$ref": "#/$defs/slackId" },
            { "$ref": "#/$defs/githubId" }
          ]
        }
      }
    }
  }
}
