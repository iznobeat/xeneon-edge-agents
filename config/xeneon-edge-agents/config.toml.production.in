# Agent manager observed at startup: "herdr" or "t3code". The portal's
# Manager control switches between them at runtime and persists the choice
# under $XDG_STATE_HOME/xeneon-edge-agents/agent-backend.toml.
agent_backend = "herdr"
voxtype_bin = "voxtype"
herdr_refresh_ms = 5000
health_refresh_ms = 1000
voice_refresh_ms = 250
usage_refresh_ms = 30000
micro_refresh_ms = 5000

[screen]
connector = "@OUTPUT_CONNECTOR@"
serial = "@OUTPUT_SERIAL@"
model = "@OUTPUT_MODEL@"
touch_device = "@TOUCH_DEVICE@"

[herdr]
# Herdr mode reads herdr-core, the terminal runtime behind the Herdr app, and
# shows agents through the Herdr app. Both sockets default to their programs'
# own locations: $XDG_RUNTIME_DIR/herdr-core/$HC_SESSION.sock (session
# "default") and $HERDR_APP_HOME/herdr-app.sock, else
# ~/.config/herdr-app/herdr-app.sock.
# core_socket = "/run/user/1000/herdr-core/default.sock"
# app_socket = "/home/user/.config/herdr-app/herdr-app.sock"

[t3code]
# T3 Code data directory. Defaults to $T3CODE_HOME, then ~/.t3. Only the
# read-only state projection and server runtime descriptor are read.
# home = "/home/user/.t3"
refresh_ms = 1000

[desktop]
edge_output = "@OUTPUT_CONNECTOR@"
herdr_class = "herdr-app"

# Launchable desktop apps (0-4) are configured per machine in desktop-apps.toml
# beside this file, which the installer never writes. Without it the built-in
# Spotify and Discord pair is used. See desktop-apps.toml.example.
