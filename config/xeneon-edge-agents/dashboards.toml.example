# Dashboards shown on the XENEON EDGE on this machine, as header tabs in this
# order. Copy to
# ~/.config/xeneon-edge-agents/dashboards.toml and restart the daemon
# (systemctl --user restart xeneon-agentd). The installer never writes this
# file. Without it only the agent command center is shown.
#
#   agents    Herdr / T3 Code agent command center
#   spotify   Now playing in the Spotify desktop client, with controls and
#             time-synced lyrics from LRCLIB (lrclib.net)
#   basecamp  Basecamp card tables as lanes plus the Hey! inbox, read through
#             the signed-in Basecamp CLI (`basecamp login`)
#   slack     Recent messages in chosen channels plus your unread DMs and
#             @-mentions, read with your own Slack user token (see below)
#   github    Open pull requests across an organization plus your unread
#             notifications, read through the signed-in GitHub CLI (gh)
#   game      A web game full-bleed under the header (Oh No! More Agents by
#             default), in its own borderless window: Quickshell cannot load
#             QtWebEngine, so it runs in Qt's qml runtime (needs qt6-webengine)

dashboards = ["agents", "basecamp", "spotify"]

# Spotify: lyrics are looked up on LRCLIB, which then learns the title,
# artist, album, and length of each track played. Turn them off with:
# [spotify]
# lyrics = false

[basecamp]
# Optional named Basecamp CLI profile (`basecamp profile list`) the dashboard
# reads as. Without it the CLI's default profile is used.
# profile = "work"

# Card tables the Basecamp dashboard can switch between (at most 6). Find the
# ids with: basecamp projects list --agent --jq '[.[] | {id, name, tables:
#   [.dock[]? | select(.name == "kanban_board") | {id, title}]}]'
[[basecamp.card_tables]]
label = "Sprint"
project = 43666346
card_table = 9711341101

# Slack: create the read-only app from config/slack/app-manifest.yaml, install
# it, and put its User OAuth Token in slack.toml beside this file:
#   install -m 600 /dev/null ~/.config/xeneon-edge-agents/slack.toml
#   token = "xoxp-..."
# Then add "slack" to `dashboards` and list the channels to show as tabs.
# [slack]
# channels = ["dev", "support"]

# GitHub: name the organization and, if gh has several accounts, which one
# to read as (`gh auth status`). Add "github" to `dashboards` to show it.
# [github]
# organization = "acme"
# user = "my-work-login"
# bin = "/usr/bin/gh"   # if `gh` on PATH is a wrapper (e.g. mise) that
#                       # cannot run in the daemon's read-only sandbox

# Game: the page shown by the "game" dashboard. It gets the real size of the
# area under the header and picks its own scale; touch reaches it as pointer
# input. Point it at a local server while developing.
# [game]
# url = "https://oh-no-more-agents.com/?full&fit"   # the default
# url = "http://localhost:8788/?full&fit"
# qml_bin = "/usr/lib/qt6/bin/qml"                  # Qt 6 qml runtime
